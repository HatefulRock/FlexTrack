{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    },
    "wear": {
      "extends": "production",
      "android": {
        "gradleCommand": ":wear:bundleRelease",
        "applicationArchivePath": "android/wear/build/outputs/bundle/release/*.aab"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
