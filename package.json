{
  "name": "flextrack",
  "private": true,
  "license": "MIT",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "maestro test .maestro",
    "e2e:smoke": "maestro test --include-tags=smoke .maestro",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "e2e:corrupt": "bash .maestro/adb/unreadable-data.sh",
    "e2e:ios": "maestro test --exclude-tags=android-only .maestro"
  },
  "dependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "@expo-google-fonts/archivo": "^0.4.2",
    "@expo-google-fonts/big-shoulders-display": "^0.2.3",
    "@kingstinct/react-native-healthkit": "^16.2.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "date-fns": "^4.1.0",
    "expo": "^58.0.21",
    "expo-build-properties": "~58.0.11",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-keep-awake": "~58.0.3",
    "expo-linear-gradient": "~58.0.3",
    "expo-notifications": "~58.1.7",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "lucide-react": "^0.555.0",
    "lucide-react-native": "^0.559.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-android-widget": "^0.25.0",
    "react-native-chart-kit": "^6.12.0",
    "react-native-health-connect": "^4.1.3",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "~19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3",
    "vite": "^6.2.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "uuid": "^11.1.1"
  }
