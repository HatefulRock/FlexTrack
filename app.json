{
  "expo": {
    "name": "FlexTrack",
    "slug": "flex-track",
    "description": "A local-first workout tracker with reusable routines, guided sessions, quick activity logging, and progress analytics.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/flextrack.png",
    "scheme": "flextrack",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.HatefulRock.flextrack",
      "config": {
        "usesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.HatefulRock.flextrack"
        ]
      }
    },
    "android": {
      "package": "com.HatefulRock.flextrack",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#141516",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.WRITE_DISTANCE",
        "android.permission.health.WRITE_EXERCISE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#141516",
          "dark": {
            "backgroundColor": "#141516"
          }
        }
      ],
      "expo-font",
      "expo-notifications",
      "./plugins/withAsyncStorageSize.cjs",
      "./plugins/withPodDeploymentTarget.cjs",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "FlexTrack does not read your health data.",
          "NSHealthUpdateUsageDescription": "FlexTrack saves your finished workouts to Apple Health when you turn on Health sync.",
          "background": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ],
      "@bacons/apple-targets",
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/big-shoulders-display/BigShouldersDisplay_800ExtraBold.ttf",
            "./node_modules/@expo-google-fonts/archivo/400Regular/Archivo_400Regular.ttf",
            "./node_modules/@expo-google-fonts/archivo/600SemiBold/Archivo_600SemiBold.ttf"
          ],
          "widgets": [
            {
              "name": "Streak",
              "label": "Streak",
              "description": "Your training streak in days.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 3600000
            },
            {
              "name": "NextWorkout",
              "label": "Next workout",
              "description": "Today's routine, or the next one on your schedule.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 3600000
            }
          ]
        }
      ],
      "./plugins/withWearApp.cjs"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "956e8652-3fbe-4108-883f-b42d8ca600b2"
      }
    }
  }
}
