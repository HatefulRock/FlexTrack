{
  "expo": {
    "name": "FlexTrack",
    "slug": "flex-track",
    "description": "A local-first workout tracker with reusable routines, guided sessions, quick activity logging, and progress analytics.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/flextrack.png",
    "scheme": "flextrack",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.HatefulRock.flextrack",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.HatefulRock.flextrack",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#141516",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#141516",
          "dark": {
            "backgroundColor": "#141516"
          }
        }
      ],
      "expo-font",
      "expo-notifications"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "956e8652-3fbe-4108-883f-b42d8ca600b2"
      }
    }
  }
}
