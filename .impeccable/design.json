      "html": "<nav class=\"ds-tabs\"><a class=\"ds-tab ds-tab-on\" href=\"#\">Today</a><a class=\"ds-tab\" href=\"#\">Routines</a><button class=\"ds-quick\" aria-label=\"Quick start\"><svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#141516\" stroke-width=\"2.75\" stroke-linecap=\"round\"><path d=\"M12 5v14M5 12h14\"/></svg></button><a class=\"ds-tab\" href=\"#\">History</a><a class=\"ds-tab\" href=\"#\">Progress</a></nav>",
      "css": ".ds-tabs{display:flex;align-items:stretch;height:72px;background:#1D1F21;border-top:1px solid #2E3236;max-width:430px}.ds-tab{position:relative;flex:1;display:flex;align-items:center;justify-content:center;min-height:56px;font-family:Archivo,sans-serif;font-weight:500;font-size:12px;line-height:16px;color:#8E908B;text-decoration:none}.ds-tab:hover{color:#C9C9C3}.ds-tab:focus-visible{outline:2px solid #F2F1EC;outline-offset:-4px}.ds-tab-on{color:#F2F1EC;font-weight:600}.ds-tab-on::before{content:'';position:absolute;top:0;width:28px;height:3px;background:#F2F1EC;border-radius:0 0 2px 2px}.ds-quick{align-self:center;width:56px;height:56px;margin:0 10px;border-radius:28px;border:4px solid #26292C;background:#F2F1EC;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:transform 100ms cubic-bezier(0.23,1,0.32,1)}.ds-quick:active{transform:scale(0.92)}.ds-quick:focus-visible{outline:2px solid #F2F1EC;outline-offset:3px}"
