      "html": "<div class=\"ds-chips\"><button class=\"ds-chip ds-chip-on\">All</button><button class=\"ds-chip\">Strength</button><button class=\"ds-chip\">Cardio</button></div>",
      "css": ".ds-chips{display:flex;gap:8px}.ds-chip{min-height:44px;padding:0 14px;border:none;border-radius:4px;background:#1D1F21;color:#C9C9C3;font-family:Archivo,sans-serif;font-weight:600;font-size:14px;line-height:18px;cursor:pointer;transition:transform 100ms cubic-bezier(0.23,1,0.32,1)}.ds-chip:hover{background:#26292C}.ds-chip:active{transform:scale(0.95)}.ds-chip:focus-visible{outline:2px solid #F2F1EC;outline-offset:2px}.ds-chip-on{background:#F2F1EC;color:#141516}.ds-chip-on:hover{background:#FFFFFF}"
