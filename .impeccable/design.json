      "html": "<button class=\"ds-btn-secondary\">Log a finished activity</button>",
      "css": ".ds-btn-secondary{min-height:52px;padding:0 20px;border:none;border-radius:6px;background:#26292C;color:#F2F1EC;font-family:Archivo,sans-serif;font-weight:700;font-size:16px;line-height:20px;cursor:pointer;transition:transform 100ms cubic-bezier(0.23,1,0.32,1)}.ds-btn-secondary:hover{background:#303438}.ds-btn-secondary:active{transform:scale(0.97)}.ds-btn-secondary:focus-visible{outline:2px solid #F2F1EC;outline-offset:3px}"
    },
