      "css": ".ds-record{background:#F3C316;color:#141516;border-radius:10px;padding:16px;max-width:360px}.ds-record-name{font-family:Archivo,sans-serif;font-weight:600;font-size:17px;line-height:22px}.ds-record-value{font-family:'Big Shoulders Display',sans-serif;font-weight:800;font-size:40px;line-height:42px;letter-spacing:-0.4px;font-variant-numeric:tabular-nums}.ds-record-was{font-family:Archivo,sans-serif;font-weight:600;font-size:14px;line-height:18px}"
